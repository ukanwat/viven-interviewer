// Cloudflare Workers deploy (free plan). The Node server (src/server.ts + Dockerfile) runs the same app anywhere else.
{
  "name": "viven-interviewer",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "run_worker_first": ["/api/*", "/ws"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "PersonRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PersonRoom"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "viven-people", "database_id": "b809a542-60d5-43b3-aa78-a32525dbf4b9" }],
  "routes": [{ "pattern": "viven-interviewer.utkarshkanwat.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
